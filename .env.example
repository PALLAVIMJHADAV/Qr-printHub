# ==============================================================================
# QR-PrintHub Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as required.
# NEVER commit .env to version control.
# ==============================================================================

# Server Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Base URLs
API_BASE_URL=http://localhost:3000/api/v1
PUBLIC_WEB_URL=http://localhost:5173

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://qrprint_user:qrprint_secure_pass@localhost:5432/qrprint_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Cache & Message Queue (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Authentication & Security
JWT_ACCESS_SECRET=change-this-to-a-super-secret-random-key-with-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-this-to-another-super-secret-random-key-with-32-chars
JWT_REFRESH_TTL=7d
PASSWORD_SALT_ROUNDS=12

# Object Storage (MinIO / S3 Private Storage)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=qrprint-documents
S3_FORCE_PATH_STYLE=true
PRESIGNED_URL_EXPIRY_SECONDS=300

# Document Processing & Retention
MAX_FILE_SIZE_MB=50
ALLOWED_MIME_TYPES=application/pdf
DOCUMENT_RETENTION_HOURS=2
DOCUMENT_PURGE_CRON="0 */1 * * *"

# Payment Gateway (Mock / Sandbox)
PAYMENT_GATEWAY_PROVIDER=mock
PAYMENT_GATEWAY_KEY_ID=mock_key_id
PAYMENT_GATEWAY_KEY_SECRET=mock_key_secret
PAYMENT_WEBHOOK_SECRET=mock_webhook_secret_for_hmac

# Print Station & Hardware Agent
PRINTER_AGENT_HEARTBEAT_INTERVAL_SECONDS=30
PRINTER_AGENT_TOKEN_TTL_DAYS=30

# Logging & Auditing
LOG_LEVEL=debug
AUDIT_LOG_ENABLED=true
